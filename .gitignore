# Vendor artifacts and decompiler output never go into git
targets/*/artifacts/
targets/*/work/
targets/*/decompiled/
*.apk
*.xapk
*.apks
*.aab
*.ipa
*.dex
*.jar
*.so
*.bin.orig
.venv/
node_modules/
__pycache__/
.pytest_cache/
*.egg-info/
reports/*
!reports/README.md

# dbug framework generated artifacts (never commit captures, keys, or session data)
sessions/
captures/
*.pcap
*.pcapng
sslkey.log
*.log
.env

# dbug orchestrator auto-generated target workspaces (test runtime output, not source)
targets/current_sample/
targets/simulated_*/
