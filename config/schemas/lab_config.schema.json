{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "lab_config.yaml schema",
  "description": "Schema for dbug lab_config.yaml configuration file",
  "type": "object",
  "required": ["lab_environment"],
  "properties": {
    "lab_environment": {
      "type": "object",
      "required": ["target_sample", "device", "network", "telemetry", "analysis_defaults"],
      "properties": {
        "target_sample": {
          "type": "object",
          "properties": {
            "apk_path": {"type": "string"},
            "package_name": {"type": "string"},
            "staging_path": {"type": "string"}
          }
        },
        "device": {
          "type": "object",
          "properties": {
            "serial": {"type": "string"},
            "connection_type": {"type": "string", "enum": ["usb", "tcpip"]},
            "adb_path": {"type": "string"},
            "remote_tmp_dir": {"type": "string"},
            "use_root": {"type": "boolean"}
          }
        },
        "network": {
          "type": "object",
          "properties": {
            "target_interface": {"type": "string"},
            "gateway_interface": {"type": "string"},
            "egress_interface": {"type": "string"},
            "gateway_ip": {"type": "string"},
            "subnet_cidr": {"type": "string"},
            "dns_port": {"type": "integer"},
            "sinkhole_mode": {"type": "boolean"}
          }
        },
        "telemetry": {
          "type": "object",
          "properties": {
            "ecapture": {"type": "object"},
            "frida": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer"},
                "spawn": {"type": "boolean"}
              }
            }
          }
        },
        "analysis_defaults": {
          "type": "object",
          "properties": {
            "profile": {"type": "string", "enum": ["malware", "privacy", "appsec", "all"]},
            "duration_seconds": {"type": "integer"},
            "interactive": {"type": "boolean"},
            "pull_artifacts": {"type": "boolean"},
            "post_clean_canaries": {"type": "boolean"},
            "uninstall_after_run": {"type": "boolean"},
            "output_dir": {"type": "string"}
          }
        }
      }
    }
  }
}
